# ==========================================================
# Achenium environment template
# Copy this file to .env and fill in values as needed.
# ==========================================================

# --------------------------
# Flask / app server
# --------------------------
# Required in production; for local development a placeholder is okay.
SECRET_KEY=change-me-in-production
# Bind all interfaces for local network access.
HOST=0.0.0.0
PORT=5000
# true/false (lowercase preferred)
DEBUG=false

# --------------------------
# OpenAI (optional)
# --------------------------
# Leave blank to use deterministic fallback research mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_TIMEOUT_SECONDS=25
OPENAI_REQUESTS_PER_MINUTE=20

# --------------------------
# Scheduler / research cadence
# --------------------------
# UTC hour (0-23) for daily research job.
DAILY_RESEARCH_HOUR_UTC=13
# Hours before market close considered “pre-close window”.
PRE_CLOSE_WINDOW_HOURS=24
# Frequency (hours) for pre-close monitoring checks.
PRE_CLOSE_CHECK_INTERVAL_HOURS=5
# Maximum markets accepted from the UI selection.
MAX_SELECTED_MARKETS=8

# --------------------------
# Persistence
# --------------------------
DB_PATH=achenium.db

# --------------------------
# Email digest (optional)
# --------------------------
# To enable digest email sending, set all of these:
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD, REPORT_RECIPIENT
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=noreply@local
REPORT_RECIPIENT=

# --------------------------
# Polymarket API integration
# --------------------------
POLYMARKET_TIMEOUT_SECONDS=10
# Required together only for authenticated CLOB endpoints.
POLY_ADDRESS=
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=
